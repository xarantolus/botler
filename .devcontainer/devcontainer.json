{
  "name": "botler",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "containerUser": "root",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-cargo,target=/opt/cargo/registry,type=volume",
    // The container's own build output, apart from the host's target/.
    "source=${localWorkspaceFolderBasename}-target,target=${containerWorkspaceFolder}/target,type=volume",
    // Image store for Podman inside the container (the hub's agents and jobs).
    "source=${localWorkspaceFolderBasename}-containers,target=/var/lib/containers,type=volume",
    "source=${localEnv:HOME}/claude-state/${localWorkspaceFolderBasename},target=/root/.claude,type=bind,consistency=cached"
  ],
  "runArgs": [
    // Its own network namespace; see run-container.sh.
    "-p=127.0.0.1:7431:7431",
    "-p=127.0.0.1:5173:5173",
    // Podman inside the container, see run-container.sh.
    "--cap-add=SYS_ADMIN",
    "--cap-add=NET_ADMIN",
    "--security-opt=unmask=ALL",
    "--security-opt=label=disable",
    "--device=/dev/fuse"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "Vue.volar"]
    }
  }
}
