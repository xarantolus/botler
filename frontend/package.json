{
  "name": "botler-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-offline.mjs && node scripts/source-hash.mjs write",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "check-dist": "node scripts/source-hash.mjs check && node scripts/check-offline.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.144",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "ai": "7.0.142",
    "happy-dom": "21.0.3",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
