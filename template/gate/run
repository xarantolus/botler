#!/bin/sh
# The deterministic gate. The hub runs this on every proposal in the dev image, after it has
# validated the definitions; agents run it themselves before proposing. Protected path: only the
# user can change it. The botler SDK comes from /opt/botler/sdk, which the hub mounts.
set -eu
cd "$(dirname "$0")/.."

run() { uv run --no-sync "$@"; }

echo "== uv sync";          uv sync --locked --all-packages
echo "== events manifest";  run python -m botler.events manifest --check
echo "== tools manifest";   run python -m botler.tools manifest --check
echo "== ruff format";      run ruff format --check .
echo "== ruff lint";        run ruff check .
echo "== pyright";          run pyright
echo "== pytest";           run pytest
echo "gate: ok"
